{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "Image URI",
      "name": "imageUri",
      "kind": "Grouping"
    },
    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure"
    },
    {
      "displayName": "Play Axis",
      "name": "playAxis",
      "kind": "Grouping"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            { "for": { "in": "category" } },
            { "for": { "in": "imageUri" } },
            { "for": { "in": "playAxis" } }
          ],
          "dataReductionAlgorithm": { "top": { "count": 1000 } }
        },
        "values": {
          "select": [
            { "for": { "in": "measure" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "animation": {
      "displayName": "Animation",
      "properties": {
        "duration": {
          "displayName": "Frame Duration (ms)",
          "type": { "numeric": true }
        },
        "frameDelay": {
          "displayName": "Frame Delay (ms)",
          "type": { "numeric": true }
        },
        "easing": {
          "displayName": "Easing",
          "type": {
            "enumeration": [
              { "displayName": "Linear", "value": "linear" },
              { "displayName": "Ease Out", "value": "easeOut" },
              { "displayName": "Ease In Out", "value": "easeInOut" }
            ]
          }
        },
        "autoplay": {
          "displayName": "Autoplay",
          "type": { "bool": true }
        },
        "loop": {
          "displayName": "Loop",
          "type": { "bool": true }
        },
        "showControls": {
          "displayName": "Show Controls",
          "type": { "bool": true }
        },
        "maxBars": {
          "displayName": "Max Bars",
          "type": { "numeric": true }
        },
        "showPlayAxisLabel": {
          "displayName": "Show Play Axis Label",
          "type": { "bool": true }
        },
        "playAxisLabelPosition": {
          "displayName": "Play Axis Label Position",
          "type": {
            "enumeration": [
              { "displayName": "Top", "value": "top" },
              { "displayName": "Bottom", "value": "bottom" }
            ]
          }
        },
        "reduceMotion": {
          "displayName": "Reduce Motion",
          "type": { "bool": true }
        }
      }
    }
    ,
    "labels": {
      "displayName": "Data Labels",
      "properties": {
        "show": { "displayName": "Show", "type": { "bool": true } },
        "fontSize": { "displayName": "Font Size", "type": { "numeric": true } },
        "color": { "displayName": "Color", "type": { "fill": { "solid": { "color": true } } } },
        "displayUnits": { "displayName": "Display Units", "type": { "numeric": true } },
        "precision": { "displayName": "Decimal Places", "type": { "numeric": true } },
        "categoryOnBars": { "displayName": "Category On Bars", "type": { "bool": true } },
        "showCategoryWithImage": { "displayName": "Show Category When Image Used", "type": { "bool": true } },
        "showImageInTooltip": { "displayName": "Show Image In Tooltip", "type": { "bool": true } },
        "iconOutline": { "displayName": "Icon Outline", "type": { "bool": true } },
        "imageInsideEnd": { "displayName": "Image Inside End", "type": { "bool": true } },
        "labelsInside": { "displayName": "Show Labels Inside Bars", "type": { "bool": true } }
      }
    },
    "axes": {
      "displayName": "Axes",
      "properties": {
        "showXAxisLabels": { "displayName": "Show X-Axis Labels", "type": { "bool": true } },
        "showYAxisLabels": { "displayName": "Show Y-Axis Labels", "type": { "bool": true } },
        "yAxisFontSize": { "displayName": "Y-Axis Font Size", "type": { "numeric": true } },
        "showGridlines": { "displayName": "Show Gridlines", "type": { "bool": true } },
        "showXAxisTitle": { "displayName": "Show X-Axis Title", "type": { "bool": true } },
        "showYAxisTitle": { "displayName": "Show Y-Axis Title", "type": { "bool": true } }
      }
    },
    "bars": {
      "displayName": "Bars",
      "properties": {
        "cornerRadius": { "displayName": "Corner Radius", "type": { "numeric": true } },
        "colorMode": {
          "displayName": "Color Mode",
          "type": {
            "enumeration": [
              { "displayName": "Auto", "value": "auto" },
              { "displayName": "Light", "value": "light" },
              { "displayName": "Dark", "value": "dark" }
            ]
          }
        }
      }
    }
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "privileges": []
}
