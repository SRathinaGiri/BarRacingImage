{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "sample_bar_chart",
  "position": {
    "x": 60,
    "y": 60,
    "z": 0,
    "height": 600,
    "width": 1120,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Category"
                    }
                  },
                  "Property": "Category"
                }
              },
              "queryRef": "Category.Category",
              "nativeQueryRef": "Category",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactTable"
                    }
                  },
                  "Property": "Total Page Views"
                }
              },
              "queryRef": "FactTable.Total Page Views",
              "nativeQueryRef": "Total Page Views"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Page views by character'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
