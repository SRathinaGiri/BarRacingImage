              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Page Views",
            "description": "Total Wikimedia page views for the selected date context.",
            "expression": [
              "CALCULATE(",
              "    SUM('FactTable'[PageViews]),",
              "    USERELATIONSHIP('FactTable'[Period], 'Date'[Date])",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Sample Measures"
          },
          {
            "name": "Character Count",
            "description": "Number of cartoon character categories in the current context.",
            "expression": "DISTINCTCOUNT('Category'[Category])",
            "formatString": "#,0",
            "displayFolder": "Sample Measures"
          },
          {
            "name": "Selected Period",
            "description": "Current month label from the Date table.",
            "expression": [
              "COALESCE(",
              "    SELECTEDVALUE('Date'[Month Year]),",
              "    FORMAT(MAX('Date'[Date]), \"MMM yyyy\")",
              ")"
            ],
            "formatString": "@",
            "displayFolder": "Sample Measures"
          },
          {
            "name": "Popularity Rank",
            "description": "Rank of each character by page views in the current period.",
            "expression": [
              "RANKX(",
              "    ALLSELECTED('Category'[Category]),",
              "    [Total Page Views],",
              "    ,",
              "    DESC,",
              "    Dense",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Sample Measures"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
