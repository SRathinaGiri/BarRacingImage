        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS(",
                "    CALENDAR(MIN('FactTable'[Period]), MAX('FactTable'[Period])),",
                "    \"Year\", YEAR([Date]),",
                "    \"Month Number\", MONTH([Date]),",
                "    \"Month\", FORMAT([Date], \"MMM\"),",
                "    \"Month Year\", FORMAT([Date], \"MMM yyyy\"),",
                "    \"Month Year Sort\", YEAR([Date]) * 100 + MONTH([Date]),",
                "    \"Quarter\", \"Q\" & FORMAT([Date], \"Q\")",
                ")"
              ]
            }
          }
        ]
      }
